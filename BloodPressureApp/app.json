{
  "expo": {
    "name": "Blood Pressure Tracker",
    "slug": "blood-pressure-tracker",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.bptracker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to capture blood pressure readings",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload blood pressure screenshots"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bptracker.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload blood pressure screenshots.",
          "cameraPermission": "The app needs camera access to take photos of blood pressure devices."
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "backgroundColor": "#ECF0F1",
    "primaryColor": "#E74C3C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
